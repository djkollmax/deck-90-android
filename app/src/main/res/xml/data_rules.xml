<?xml version="1.0" encoding="utf-8"?>
<!-- 0.1.10: the same for Android 12 and later, in the cloud backup and a move to a new phone -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jellyfin.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jellyfin.xml" />
    </device-transfer>
</data-extraction-rules>
